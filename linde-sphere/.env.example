# Linde Sphere environment variables — names and non-secret defaults only.
# Copy to .env (git-ignored) and fill in values locally. Never commit real credentials.
# Empty values mean "not set". Validated at startup by src/server/env.ts.

# production | demo  (production shows only validated content)
CONTENT_MODE=demo
# Development-only preview of placeholder content; always ignored in production builds.
CONTENT_PREVIEW_PLACEHOLDERS=false

# SQLite database location (relative to the project root). Create/upgrade it with `npm run db:deploy`.
# Note: Prisma CLI commands read DATABASE_URL from the shell, not from this file.
DATABASE_URL=file:./data/linde-sphere.db

# TCP port of the server. Read by the Windows launch scripts (scripts/windows, ADR-059); a -Port parameter
# or a PORT environment variable takes precedence. `npm run start:network` ignores this line: use
# `npm run start:network -- -p 3001` there.
PORT=3000

# Lead retention, in days. PLACEHOLDER: the company's retention policy has not been decided. Leave empty
# (= no retention period configured; nothing is ever deleted automatically) until legal/privacy approve one.
LEAD_RETENTION_DAYS=

# ---- Follow-up strategy (ADR-062) --------------------------------------------------------------
# What happens after a visitor asks for their personalized summary. Allowed values:
#   LOCAL_PACKAGE   (default) store the lead and its report (HTML, text, JSON) locally, marked as
#                   follow-up pending. NO email is attempted. Hand the Convention Export Package
#                   (admin → Exportaciones, or `npm run followup:package`) to the sales team.
#   SMTP_EMAIL      send the report automatically through EMAIL_PROVIDER (set EMAIL_PROVIDER=smtp and the
#                   SMTP_* values below; with EMAIL_PROVIDER=preview it is a dry run that never sends).
#                   Requires Linde IT/security approval of the relay and sender (RELEASE_READINESS gates 6–7).
#   MICROSOFT_GRAPH not implemented yet: refused at start-up (needs an Entra ID app registration).
#   OUTLOOK_DRAFT   not implemented yet: refused at start-up (architecture placeholder, ARCHITECTURE §9.7).
FOLLOW_UP_MODE=LOCAL_PACKAGE

# ---- Email delivery (ADR-054) — used only when FOLLOW_UP_MODE=SMTP_EMAIL ----------------------------
# preview (default): DevelopmentPreviewProvider — builds each email and saves it under EMAIL_PREVIEW_DIR;
#                    nothing is sent. Use for development and rehearsals.
# smtp:              real delivery through your organization's SMTP relay (with FOLLOW_UP_MODE=SMTP_EMAIL).
# graph:             NOT available (needs an organizational Microsoft Entra app registration); rejected.
EMAIL_PROVIDER=preview
# Sender shown to visitors. Required for smtp. Example (dummy): Linde Sphere <reportes@example.com>
EMAIL_FROM=
# Optional reply-to address (for example the sales team). Example (dummy): ventas@example.com
EMAIL_REPLY_TO=
# Automatic attempts per email before it is marked failed (then retry manually: npm run email:retry).
EMAIL_MAX_ATTEMPTS=12
# How often (ms) the server looks for emails due for a retry.
EMAIL_WORKER_INTERVAL_MS=15000
# Where the preview provider writes .eml/.html/.txt files (relative to the project root).
EMAIL_PREVIEW_DIR=data/email-preview

# Required only when EMAIL_PROVIDER=smtp. Dummy example values:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587            (STARTTLS)  or 465 with SMTP_SECURE=true (implicit TLS)
#   SMTP_USER=reportes@example.com
#   SMTP_PASS=change-me
SMTP_HOST=
SMTP_PORT=
# true = implicit TLS (port 465). false = STARTTLS, which is then required (see SMTP_REQUIRE_TLS).
SMTP_SECURE=
# Keep true. Only a local test mail server outside production may use false (refused in production).
SMTP_REQUIRE_TLS=true
# Set both or neither (some relays authenticate by IP address).
SMTP_USER=
SMTP_PASS=

# ---- Kiosk session timing (ADR-055), in seconds. Leave empty for the defaults in app-config.ts. ----
# Inactivity before the "¿Sigue ahí?" warning, and its countdown (default 60 and 15).
KIOSK_IDLE_WARNING_SECONDS=
KIOSK_IDLE_COUNTDOWN_SECONDS=
# Same on the contact form, where typing takes longer (default 120 and 20).
KIOSK_FORM_IDLE_WARNING_SECONDS=
KIOSK_FORM_IDLE_COUNTDOWN_SECONDS=
# How long the completion screen stays before returning to the attract screen (default 15).
KIOSK_COMPLETION_SECONDS=

# ---- Network and abuse protection (ADR-057) ------------------------------------------------------
# Extra hostnames the server answers to (comma-separated). localhost, private IPv4 addresses (the laptop's
# hotspot/LAN IP) and *.local names always work; any other Host header is refused (DNS rebinding).
ALLOWED_HOSTS=
# Lead submissions per client address per minute (global cap = 6×). The default suits one kiosk.
LEAD_RATE_LIMIT_PER_MINUTE=10

# ---- Local administration utility (ADR-056) — MVP protection only, NOT enterprise authentication ----
# Off by default. Keep it off at the event unless someone needs it; a production deployment requires
# approved authentication and a security review.
ADMIN_ENABLED=false
# Public path of the admin pages (one segment, lowercase). Choose your own; it is never linked anywhere.
ADMIN_PATH=/admin-local
# scrypt hash of the admin passphrase. Create it with `npm run admin:passphrase` and paste the printed line.
# Never put the passphrase itself in this file. (ADMIN_USER / ADMIN_PASSWORD are no longer accepted.)
ADMIN_PASSPHRASE_HASH=
# Sign-in expires after this many minutes without activity (default 30).
ADMIN_SESSION_MINUTES=

# Development component gallery (/dev/components). Always on with `npm run dev`; in production builds
# it returns 404 unless explicitly enabled here. Keep false at the event.
ENABLE_COMPONENT_GALLERY=false

# Scene coordinate calibration (/dev/scenes): tap a scene to read normalized hotspot x/y. Always on with
# `npm run dev`; in production builds it returns 404 unless explicitly enabled here. Keep false at the event.
ENABLE_SCENE_CALIBRATION=false

# Extra hostnames allowed to use the dev server's HMR (comma-separated). Private LAN ranges are allowed by default.
DEV_ALLOWED_ORIGINS=

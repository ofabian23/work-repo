{
  "name": "linde-sphere",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H localhost",
    "build": "prisma generate && next build",
    "start": "next start -H localhost",
    "lint": "eslint --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/content-check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run content:check && npm run content:export -- --check && npm run lint && npm run typecheck && npm run format:check && npm run test",
    "dev:network": "next dev -H 0.0.0.0",
    "start:network": "next start -H 0.0.0.0",
    "test:e2e": "playwright test",
    "content:export": "tsx scripts/content-export.ts",
    "art:placeholders": "tsx scripts/placeholder-art.ts",
    "art:scenes": "tsx scripts/scene-art.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:backup": "tsx --conditions=react-server scripts/db-backup.ts",
    "db:export": "tsx --conditions=react-server scripts/db-export.ts",
    "followup:package": "tsx --conditions=react-server scripts/follow-up-package.ts",
    "email:status": "tsx --conditions=react-server scripts/email-admin.ts status",
    "email:retry": "tsx --conditions=react-server scripts/email-admin.ts retry",
    "email:preview": "tsx --conditions=react-server scripts/email-admin.ts preview",
    "admin:passphrase": "tsx --conditions=react-server scripts/admin-passphrase.ts",
    "security:bundle": "tsx scripts/check-client-bundle.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "12.11.1",
    "next": "16.3.7",
    "nodemailer": "10.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0 || >=24.0.0"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
